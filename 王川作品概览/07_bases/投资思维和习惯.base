filters:
  and:
    - file.inFolder("王川作品概览")
    - database == "投资思维和习惯"
properties:
  file.name:
    displayName: 标题
  summary:
    displayName: 摘要
  sections:
    displayName: 章节
views:
  - type: table
    name: 投资思维和习惯
    order: [file.name, summary, sections]
    sort:
      - property: database_order
        direction: ASC
